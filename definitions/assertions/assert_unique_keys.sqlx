config {
  type: "assertion",
  description: "Every model has exactly one row per key. Returns the duplicated keys."
}

SELECT 'int_leads_enriched' AS model, lead_id AS key_value, COUNT(*) AS row_count
FROM ${ref("int_leads_enriched")}
GROUP BY lead_id
HAVING COUNT(*) > 1

UNION ALL

SELECT 'stg_dates' AS model, CAST(date_day AS STRING) AS key_value, COUNT(*) AS row_count
FROM ${ref("stg_dates")}
GROUP BY date_day
HAVING COUNT(*) > 1

UNION ALL

SELECT 'stg_locations' AS model, CAST(location_id AS STRING) AS key_value, COUNT(*) AS row_count
FROM ${ref("stg_locations")}
GROUP BY location_id
HAVING COUNT(*) > 1

UNION ALL

SELECT
  'fct_daily_channel_performance' AS model,
  CONCAT(CAST(date_day AS STRING), '|', CAST(location_id AS STRING), '|', source, '|', medium, '|', campaign) AS key_value,
  COUNT(*) AS row_count
FROM ${ref("fct_daily_channel_performance")}
GROUP BY date_day, location_id, source, medium, campaign
HAVING COUNT(*) > 1

UNION ALL

SELECT
  'fct_location_performance' AS model,
  CONCAT(CAST(month_start AS STRING), '|', CAST(location_id AS STRING)) AS key_value,
  COUNT(*) AS row_count
FROM ${ref("fct_location_performance")}
GROUP BY month_start, location_id
HAVING COUNT(*) > 1

UNION ALL

SELECT
  'fct_lead_funnel' AS model,
  CONCAT(CAST(cohort_month AS STRING), '|', CAST(location_id AS STRING), '|', channel_group) AS key_value,
  COUNT(*) AS row_count
FROM ${ref("fct_lead_funnel")}
GROUP BY cohort_month, location_id, channel_group
HAVING COUNT(*) > 1
